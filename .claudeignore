# Dependencies - biggest token waster
node_modules/
.pnp.*
.yarn/*

# Build outputs - no need to read compiled code
.next/
out/
build/
coverage/
dist/

# Git internals
.git/

# Databases
*.db
*.db-shm
*.db-wal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (secrets)
.env*

# OS files
.DS_Store
Thumbs.db

# Lock files (huge, no value for context)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Assets that eat tokens
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.woff
*.woff2
*.ttf
*.eot
*.mp4
*.webm
*.pdf

# Vercel
.vercel/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Config files Claude doesn't need to scan
tsconfig.json
eslint.config.mjs
postcss.config.mjs
tailwind.config.*

# Uploads
uploads/

# Misc generated
*.map
*.d.ts
.turbo/
.cache/
